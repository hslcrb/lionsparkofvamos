{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["es2022"],
        "types": ["@cloudflare/workers-types", "node"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "skipLibCheck": true,
        "noEmit": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "esModuleInterop": true
    },
    "include": ["./**/*.ts", "../src/room.ts"]
}
