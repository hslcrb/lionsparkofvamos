{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lionsparkofvamos",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-02",
  "assets": { "directory": "./out", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none", "not_found_handling": "none" },
  "durable_objects": { "bindings": [{ "name": "CHEER_ROOM", "class_name": "CheerRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CheerRoom"] }],
  "observability": { "enabled": true }
}
