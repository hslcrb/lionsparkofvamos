{
    "compilerOptions": {
        "target": "ES2022",
        "lib": [
            "dom",
            "dom.iterable",
            "es2022"
        ],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "skipLibCheck": true,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "react-jsx",
        "incremental": true,
        "plugins": [
            {
                "name": "next"
            }
        ],
        "paths": {
            "@/*": [
                "./src/*"
            ]
        },
        "allowJs": false
    },
    "include": [
        "next-env.d.ts",
        "next.config.ts",
        "eslint.config.mts",
        "src/**/*.ts",
        "src/**/*.tsx",
        "test/**/*.ts",
        ".next/types/**/*.ts",
        ".next/dev/types/**/*.ts",
        "scripts/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "worker",
        "out"
    ]
}
