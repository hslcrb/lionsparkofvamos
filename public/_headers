# Cloudflare Workers 정적 자산 헤더 — 정적 서빙 최적화
# 해시가 붙은 번들은 1년 immutable, 3D 자산(14.6 MB GLB)은 하루 + SWR,
# 나머지 정적 파일은 하루 캐시. 규칙은 겹치지 않게 두었습니다(Cloudflare는
# 일치하는 모든 규칙의 헤더를 이어 붙입니다).
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/draco/*
  Cache-Control: public, max-age=31536000, immutable

/models/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
